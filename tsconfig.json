{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": { "react-html-3.2": ["./src/index.ts"], "react-html-3.2/eslint": ["./src/eslint/index.ts"] }
  },
  "include": ["src", "test", "example", "*.ts"]
}
